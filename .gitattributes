# Normalise line endings. Without this, a Windows editor commits CRLF and the
# next person on a Mac rewrites the whole file to LF, so a one-line content
# change shows up as a 600-line diff in pages.ts and nobody can review it.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
